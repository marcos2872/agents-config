{
  "manifest_version": 3,
  "name": "browser-use",
  "version": "0.1.0",
  "description": "Dá ao Pi acesso ao navegador (abas, acessibilidade, cliques, screenshots), sem UI.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "browser-use",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "activeTab",
    "alarms",
    "offscreen",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
