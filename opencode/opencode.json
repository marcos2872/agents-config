{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -fr /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf --no-preserve-root *", "effect": "deny" },
    { "action": "shell", "resource": "git push --force *", "effect": "deny" },
    { "action": "shell", "resource": "git push -f *", "effect": "deny" },
    { "action": "read", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*/.env", "effect": "deny" },
    { "action": "edit", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "edit", "resource": "*/.env", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "allow" }
  ],
  "formatter": true,
  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },
  "watcher": { "ignore": ["dist/**", "build/**", "coverage/**", ".next/**", "*.log"] },
  "compaction": { "auto": true, "keep": { "tokens": 20000 }, "buffer": 16000 },
  "snapshots": true,
  "websearch": { "provider": "random" },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "chrome-devtools-mcp@latest"],
        "disabled": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  }
}
